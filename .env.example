# ---- Servidor ----
PORT=3000
NODE_ENV=development
# URL pública do app (usada em links das notificações e CORS)
APP_URL=http://localhost:5173

# ---- Banco de dados PostgreSQL ----
DATABASE_URL=postgres://myday:myday@localhost:5432/myday

# ---- Segurança ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
# Permitir novos cadastros (defina false depois de criar sua conta)
ALLOW_SIGNUP=true

# ---- Web Push (VAPID) ----
# Gere com: npm run vapid   (NUNCA publique a chave privada)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# ---- Agendador ----
# Desative em instâncias extras se rodar várias réplicas (o controle de duplicidade já é feito no banco)
SCHEDULER_ENABLED=true
DEFAULT_TIMEZONE=America/Sao_Paulo
